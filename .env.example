# Copy to .env.local. All variables are optional.
# Without any of these, Sigma Broadcast runs fully on-device.

# local | proxy | azure-openai | github-models
# Leave empty to auto-detect: proxy > azure-openai > github-models > local.
VITE_AI_PROVIDER=

# Recommended for public deployments. The API key stays server-side.
# Local Functions: http://localhost:7071/api/ai
# Azure Static Web Apps: /api/ai
VITE_AI_PROXY_URL=

# Label shown in the AI panel.
VITE_AI_MODEL_LABEL=

# Direct Azure OpenAI access from the browser.
# WARNING: VITE_* variables are embedded in the client bundle.
# Use the proxy instead for any deployment.
VITE_AZURE_OPENAI_ENDPOINT=
VITE_AZURE_OPENAI_KEY=
VITE_AZURE_OPENAI_DEPLOYMENT=
VITE_AZURE_OPENAI_API_VERSION=2024-10-21

# Direct GitHub Models access from the browser.
# WARNING: VITE_* variables are embedded in the client bundle.
VITE_GITHUB_MODELS_TOKEN=
VITE_GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Application Insights. Telemetry is disabled when empty.
VITE_APPINSIGHTS_CONNECTION_STRING=

# Vite base path. Use / for Azure Static Web Apps, /sigmabroadcast/ for GitHub Pages.
VITE_BASE=/
