{
  "name": "sigma-broadcast",
  "private": true,
  "version": "0.1.0",
  "description": "Sigma Broadcast — a synthetic football match, intelligently broadcast.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "models:train": "node scripts/train-models.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "video:capture": "node video/scripts/capture-product.mjs",
    "video:narration": "node video/scripts/narration.mjs",
    "video:studio": "remotion studio video/src/index.ts --public-dir=video/public",
    "video:render:demo": "remotion render video/src/index.ts DEMO video/out/DEMO.mp4 --public-dir=video/public --codec=h264 --crf=18 --pixel-format=yuv420p",
    "video:render:pitch": "remotion render video/src/index.ts PITCH video/out/PITCH.mp4 --public-dir=video/public --codec=h264 --crf=18 --pixel-format=yuv420p",
    "video:render": "npm run video:render:demo && npm run video:render:pitch",
    "video:verify": "node video/scripts/verify.mjs",
    "video:typecheck": "tsc -p video/tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "@microsoft/applicationinsights-web": "^3.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.538",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "remotion": "^4.0.538",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
